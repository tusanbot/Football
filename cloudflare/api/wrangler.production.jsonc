{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-empire-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "allow_eval_during_startup"],
  "keep_vars": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "bac8e3a5fdd34a969913fd5a40c28737"
    }
  ],
  "dev": { "port": 8787 },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MATCH_COORDINATOR", "class_name": "MatchCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchCoordinator"] }],
  "triggers": { "crons": ["* * * * *"] }
}
