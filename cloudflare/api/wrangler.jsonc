{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-empire-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ENVIRONMENT": "development" },
  "dev": { "port": 8787 },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MATCH_COORDINATOR", "class_name": "MatchCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchCoordinator"] }],
  "triggers": { "crons": ["* * * * *"] }
}
