{
  "name": "@football/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed:special": "tsx prisma/seed-special-players.ts",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@football/domain": "workspace:*",
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2",
    "@prisma/adapter-pg": "^6.19.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "@types/pg": "^8.15.5"
  }
}
