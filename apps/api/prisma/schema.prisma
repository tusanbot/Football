model EventTournament {
  id String @id @default(cuid())
  idempotencyKey String @unique
  title String
  description String @db.Text
  status EventTournamentStatus @default(REGISTRATION)
  entryFeeAsset WalletAsset?
  entryFeeAmount BigInt @default(0)
  maxParticipants Int @default(128)
  registrationEndsAt DateTime
  startsAt DateTime
  endsAt DateTime?
  createdByTelegramId String
  finalizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants EventTournamentParticipant[]
  prizes EventTournamentPrize[]
  @@index([status, registrationEndsAt, startsAt])
  @@index([createdAt])
}

model EventTournamentParticipant {
  id String @id @default(cuid())
  tournamentId String
  userId String
  clubId String
  placement Int?
  score Int @default(0)
  joinedAt DateTime @default(now())
  prizeSettledAt DateTime?
  tournament EventTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  prizeAwards EventTournamentPrizeAward[]
  @@unique([tournamentId, userId])
  @@unique([tournamentId, clubId])
  @@index([tournamentId, placement, score])
  @@index([userId, joinedAt])
}

model EventTournamentPrize {
  id String @id @default(cuid())
  tournamentId String
  placement Int
  type EventTournamentPrizeType
  amount BigInt @default(0)
  itemKey String?
  specialPlayerId String?
  createdAt DateTime @default(now())
  tournament EventTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  specialPlayer SpecialPlayer? @relation(fields: [specialPlayerId], references: [id], onDelete: Restrict)
  awards EventTournamentPrizeAward[]
  @@index([tournamentId, placement])
}

model EventTournamentPrizeAward {
  id String @id @default(cuid())
  participantId String
  prizeId String
  status String @default("AWARDED")
  detail Json?
  createdAt DateTime @default(now())
  participant EventTournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  prize EventTournamentPrize @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  @@unique([participantId, prizeId])
  @@index([createdAt])
}

model PilotAnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  eventName  String   @db.VarChar(40)
  userKey    String   @db.VarChar(32)
  actionKey  String   @default("") @db.VarChar(64)
  chatType   String   @default("unknown") @db.VarChar(16)
  source     String   @db.VarChar(16)
  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([eventName, occurredAt])
  @@index([userKey, occurredAt])
  @@index([source, occurredAt])
}
