  attempts       Int                          @default(0)
  lockedUntil    DateTime?
  claimToken     String?
  lastError      String?
  deletedAt      DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([telegramChatId, messageId])
  @@index([status, deleteAt, availableAt])
  @@index([status, lockedUntil])
}


model AdminRoleAssignment {
  id String @id @default(cuid())
  telegramId String @unique
  role String
  active Boolean @default(true)
  createdByTelegramId String
  updatedByTelegramId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([role, active])
}

model GameSetting {
  id String @id @default(cuid())
  key String @unique
  value Json
  description String?
  updatedByTelegramId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([updatedAt])
}


model SeasonPlayerAward {
  id String @id @default(cuid())
  season Int
  playerId String
  awardType String
  awardName String
  reason String?
  createdByTelegramId String
  updatedByTelegramId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([season, playerId, awardType])
  @@index([season, awardType])
  @@index([playerId, season])
