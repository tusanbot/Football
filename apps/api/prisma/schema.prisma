generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletAsset {
  CASH
  GOLD
}
enum LedgerDirection {
  CREDIT
  DEBIT
}
enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}
enum ChallengeStatus {
  DRAFT
  OPEN
  RUNNING
  COMPLETED
  CANCELLED
}

enum GroupPointSource {
  DAILY_ACTIVITY
  CHALLENGE_REWARD
  LEAGUE_REWARD
  ADMIN_ADJUSTMENT
  SHOP_PURCHASE
  GAME_ACTIVITY
}
enum PlayerOrigin {
  GENERATED
  SPECIAL
}
enum PlayerPosition {
  GK
  RB
  LB
  CB
  CDM
  CM
  CAM
  RW
  LW
  ST
}
enum PlayerStatus {
  ACTIVE
  LISTED
  INJURED
  RETIRED
  CONTRACT_EXPIRED
}
enum SpecialRarity {
  RARE
  EPIC
  LEGENDARY
  ICON
}
enum MarketListingStatus {
  OPEN
  SOLD
  CANCELLED
  EXPIRED
}
enum TrainingFocus {
  BALANCED
  GOALKEEPING
  DEFENDING
  PASSING
  PLAYMAKING
  DRIBBLING
  SHOOTING
  PHYSICAL
}
enum TrainingIntensity {
  LIGHT
  NORMAL
  INTENSE
}

enum AcademyProspectStatus {
  AVAILABLE
  RECRUITED
  RELEASED
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MatchType {
  FRIENDLY
  LEAGUE
  CUP
}

enum MatchEventType {
  GOAL
  YELLOW_CARD
  RED_CARD
  INJURY
  SUBSTITUTION
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CompetitionFormat {
  LEAGUE
  CUP
}

model User {
  id                 String              @id @default(cuid())
  telegramId         String              @unique
  username           String?
  displayName        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  club               Club?
  wallets            Wallet[]
  ledgerTransactions LedgerTransaction[]
  groupMemberships   GroupMembership[]
  groupChallengeParticipations GroupChallengeParticipant[]
  groupRewardBalances GroupMemberRewardBalance[]
  groupPointEntries   GroupPointLedger[]
  specialAcquisitions SpecialPlayerAcquisition[]
  trainingLogs PlayerTrainingLog[]
  contractRenewals PlayerContractRenewal[]
}

model Club {
  id         String   @id @default(cuid())
  ownerId    String   @unique
  name       String
  slug       String   @unique
  level      Int      @default(1)
  reputation Int      @default(0)
  formation  String   @default("4-3-3")
  mentality  String   @default("BALANCED")
  pressing   String   @default("MID_BLOCK")
  tempo      String   @default("NORMAL")
  passingStyle String @default("MIXED")
  lineupVersion Int   @default(0)
  trainingGroundLevel Int @default(1)
  lastDailyTickAt DateTime @default(now())
  lastPayrollAt DateTime @default(now())
  wageArrears BigInt @default(0)
  stadiumLevel Int @default(1)
  ticketPrice BigInt @default(50)
  academyLevel Int @default(0)
  lastEconomyTickAt DateTime @default(now())
  operatingArrears BigInt @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  players    Player[]
  sales      PlayerMarketListing[] @relation("ListingSeller")
  purchases  PlayerMarketListing[] @relation("ListingBuyer")
  specialAcquisitions SpecialPlayerAcquisition[]
  coach Coach?
  dailyTicks ClubDailyTick[]
  payrolls ClubPayroll[]
  trainingLogs PlayerTrainingLog[]
  contractRenewals PlayerContractRenewal[]
  sponsors SponsorContract[]
  academyProspects AcademyProspect[]
  financeEntries ClubFinanceEntry[]
  economyTicks ClubEconomyTick[]
  homeMatches FootballMatch[] @relation("MatchHomeClub")
  awayMatches FootballMatch[] @relation("MatchAwayClub")
  competitionEntries CompetitionEntry[]
  matchPerformances PlayerMatchPerformance[]
}

model Player {
  id              String         @id @default(cuid())
  clubId          String
  firstName       String
  lastName        String
  nationality     String         @db.VarChar(2)
  age             Int
  position        PlayerPosition
  overall         Int
  potential       Int
  attributes      Json
  wage            BigInt
  contractDays    Int
  morale          Int            @default(75)
  fitness         Int            @default(100)
  origin          PlayerOrigin   @default(GENERATED)
  status          PlayerStatus   @default(ACTIVE)
  lineupSlot      Int?
  ageDays         Int            @default(0)
  trainingFocus   TrainingFocus  @default(BALANCED)
  injuryUntil     DateTime?
  lastTrainedAt   DateTime?
  specialPlayerId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  club            Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  specialPlayer   SpecialPlayer? @relation(fields: [specialPlayerId], references: [id], onDelete: Restrict)
  specialAcquisition SpecialPlayerAcquisition?
  marketListings  PlayerMarketListing[]
  trainingLogs    PlayerTrainingLog[]
  contractRenewals PlayerContractRenewal[]
  matchPerformances PlayerMatchPerformance[]

  @@index([clubId, status])
  @@index([clubId, position])
  @@unique([clubId, lineupSlot])
  @@index([nationality])
  @@unique([clubId, specialPlayerId])
}


model Coach {
  id             String   @id @default(cuid())
  clubId         String   @unique
  name           String
  level          Int      @default(1)
  trainingSkill  Int      @default(35)
  recoverySkill  Int      @default(30)
  medicalSkill   Int      @default(25)
  weeklySalary   BigInt   @default(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model ClubDailyTick {
  id          String   @id @default(cuid())
  clubId      String
  gameDate    DateTime @db.Date
  elapsedDays Int
  createdAt   DateTime @default(now())
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([clubId, gameDate])
  @@index([gameDate])
}


model ClubPayroll {
  id             String   @id @default(cuid())
  clubId         String
  payrollDate    DateTime @db.Date
  weeksCovered   Int
  playerWages    BigInt
  coachWages     BigInt
  arrearsBefore  BigInt
  totalDue       BigInt
  cashPaid       BigInt
  arrearsAfter   BigInt
  playersCount   Int
  createdAt      DateTime @default(now())
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([clubId, payrollDate])
  @@index([payrollDate])
}

model PlayerTrainingLog {
  id              String           @id @default(cuid())
  idempotencyKey  String           @unique
  userId          String
  clubId          String
  playerId        String
  trainingDate    DateTime         @db.Date
  focus           TrainingFocus
  intensity       TrainingIntensity
  cashCost        BigInt
  overallBefore   Int
  overallAfter    Int
  fitnessBefore   Int
  fitnessAfter    Int
  attributesBefore Json
  attributesAfter  Json
  injuryOccurred  Boolean          @default(false)
  injuryUntil     DateTime?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  club            Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  player          Player           @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@unique([playerId, trainingDate])
  @@index([clubId, trainingDate])
  @@index([userId, createdAt])
}

model PlayerContractRenewal {
  id              String   @id @default(cuid())
  idempotencyKey  String   @unique
  userId          String
  clubId          String
  playerId        String
  extensionDays   Int
  oldContractDays Int
  newContractDays Int
  oldWage         BigInt
  newWage         BigInt
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  @@index([clubId, createdAt])
  @@index([playerId, createdAt])
}


model SponsorContract {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  clubId         String
  partnerName    String
  tier           String
  dailyIncome    BigInt
  signingBonus   BigInt
  startedAt      DateTime
  endsAt         DateTime
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@index([clubId, status, endsAt])
}

model AcademyProspect {
  id                String   @id @default(cuid())
  clubId            String
  firstName         String
  lastName          String
  nationality       String   @db.VarChar(2)
  age               Int
  position          PlayerPosition
  overall           Int
  potential         Int
  attributes        Json
  recruitmentCost   BigInt
  status            AcademyProspectStatus @default(AVAILABLE)
  recruitedPlayerId String?  @unique
  createdAt         DateTime @default(now())
  recruitedAt       DateTime?
  club              Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@index([clubId, status, createdAt])
}

model ClubFinanceEntry {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  clubId         String
  category       String
  direction      LedgerDirection
  amount         BigInt
  description    String
  occurredAt     DateTime @default(now())
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@index([clubId, occurredAt])
  @@index([clubId, category, occurredAt])
}

model ClubEconomyTick {
  id          String   @id @default(cuid())
  clubId      String
  gameDate    DateTime @db.Date
  elapsedDays Int
  income      BigInt
  expenses    BigInt
  paid        BigInt
  arrears     BigInt
  createdAt   DateTime @default(now())
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([clubId, gameDate])
  @@index([gameDate])
}

model Competition {
  id          String @id @default(cuid())
  idempotencyKey String @unique
  name        String
  season      Int
  format      CompetitionFormat @default(LEAGUE)
  status      CompetitionStatus @default(REGISTRATION)
  maxTeams    Int @default(8)
  createdByClubId String
  groupId String?
  group TelegramGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  allianceId String?
  alliance Alliance? @relation(fields: [allianceId], references: [id], onDelete: SetNull)
  allianceSeasonId String?
  startsAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     CompetitionEntry[]
  matches     FootballMatch[]
  @@index([status, createdAt])
  @@index([groupId, status])
  @@index([allianceId])
}

model CompetitionEntry {
  id            String @id @default(cuid())
  competitionId String
  clubId        String
  played        Int @default(0)
  won           Int @default(0)
  drawn         Int @default(0)
  lost          Int @default(0)
  goalsFor      Int @default(0)
  goalsAgainst  Int @default(0)
  points        Int @default(0)
  joinedAt      DateTime @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  club          Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([competitionId, clubId])
  @@index([competitionId, points, goalsFor])
}

model FootballMatch {
  id             String @id @default(cuid())
  idempotencyKey String @unique
  type           MatchType @default(FRIENDLY)
  status         MatchStatus @default(SCHEDULED)
  homeClubId     String
  awayClubId     String
  competitionId  String?
  round          Int?
  scheduledAt    DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  seed           String
  simulationVersion Int @default(1)
  homeScore      Int?
  awayScore      Int?
  homePenalties  Int?
  awayPenalties  Int?
  winnerClubId   String?
  attendance     Int @default(0)
  ticketRevenue  BigInt @default(0)
  homeExpectedGoals Float?
  awayExpectedGoals Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  homeClub       Club @relation("MatchHomeClub", fields: [homeClubId], references: [id], onDelete: Restrict)
  awayClub       Club @relation("MatchAwayClub", fields: [awayClubId], references: [id], onDelete: Restrict)
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  events         MatchEvent[]
  performances  PlayerMatchPerformance[]
  @@index([homeClubId, scheduledAt, status])
  @@index([awayClubId, scheduledAt, status])
  @@index([competitionId, round])
  @@index([status, scheduledAt])
}

model MatchEvent {
  id               String @id @default(cuid())
  matchId          String
  sequence         Int
  minute           Int
  type             MatchEventType
  teamId           String
  playerId         String
  relatedPlayerId  String?
  detail           String
  createdAt        DateTime @default(now())
  match            FootballMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@unique([matchId, sequence])
  @@index([matchId, minute])
}

model PlayerMatchPerformance {
  id           String @id @default(cuid())
  matchId      String
  playerId     String
  clubId       String
  minutesPlayed Int @default(90)
  goals        Int @default(0)
  assists      Int @default(0)
  shots        Int @default(0)
  passes       Int @default(0)
  tackles      Int @default(0)
  yellowCards  Int @default(0)
  redCards     Int @default(0)
  rating       Float
  fitnessLoss  Int
  match        FootballMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player       Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  club         Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([matchId, playerId])
  @@index([clubId, matchId])
  @@index([playerId, matchId])
}

model SpecialPlayer {
  id          String    @id @default(cuid())
  slug        String    @unique
  fullName    String
  nationality String    @db.VarChar(2)
  birthDate   DateTime?
  positions   String[]
  rarity      SpecialRarity @default(RARE)
  acquisitionMethods String[] @default([])
  overall     Int
  potential   Int
  attributes  Json
  sourceNote  String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  players     Player[]
  acquisitions SpecialPlayerAcquisition[]
}

model SpecialPlayerAcquisition {
  id             String       @id @default(cuid())
  idempotencyKey String       @unique
  userId         String
  clubId         String
  specialPlayerId String
  playerId       String       @unique
  method         String
  asset          WalletAsset  @default(GOLD)
  amount         BigInt
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  club           Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  specialPlayer  SpecialPlayer @relation(fields: [specialPlayerId], references: [id], onDelete: Restrict)
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([clubId, createdAt])
  @@index([specialPlayerId, createdAt])
}

model PlayerMarketListing {
  id           String              @id @default(cuid())
  playerId     String
  sellerClubId String
  buyerClubId  String?
  askingPrice  BigInt
  status       MarketListingStatus @default(OPEN)
  expiresAt    DateTime
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  player       Player              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  sellerClub   Club                @relation("ListingSeller", fields: [sellerClubId], references: [id], onDelete: Restrict)
  buyerClub    Club?               @relation("ListingBuyer", fields: [buyerClubId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt, createdAt])
  @@index([sellerClubId, status])
  @@index([playerId, status])
}

model Wallet {
  id        String     @id @default(cuid())
  userId    String
  asset     WalletAsset
  balance   BigInt     @default(0)
  version   Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, asset])
}

model LedgerTransaction {
  id             String          @id @default(cuid())
  idempotencyKey String          @unique
  userId         String
  asset          WalletAsset
  direction      LedgerDirection
  amount         BigInt
  reason         String
  referenceType  String?
  referenceId    String?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

model TelegramGroup {
  id          String           @id @default(cuid())
  telegramId  String           @unique
  title       String
  createdAt   DateTime         @default(now())
  memberships GroupMembership[]
  challenges  GroupChallenge[]
  rewardBalances GroupMemberRewardBalance[]
  pointEntries GroupPointLedger[]
  localCompetitions Competition[]
  createdAlliances Alliance[] @relation("AllianceCreatorGroup")
  allianceMembership AllianceGroup?
  allianceInvitations AllianceInvitation[]
  rewardGrants GroupRewardGrant[]
  memberCount Int @default(0)
  isActive Boolean @default(false)
  points BigInt @default(0)
  lastMemberCountCheckAt DateTime?
}

model GroupMembership {
  id       String        @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole     @default(MEMBER)
  joinedAt DateTime      @default(now())
  group    TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model GroupChallenge {
  id        String           @id @default(cuid())
  idempotencyKey String? @unique
  groupId   String
  title     String
  status    ChallengeStatus  @default(DRAFT)
  startsAt  DateTime?
  endsAt    DateTime?
  rewardPoints BigInt @default(0)
  createdByUserId String @default("")
  createdAt DateTime         @default(now())
  group     TelegramGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants GroupChallengeParticipant[]
  @@index([groupId, status])
}

model GroupChallengeParticipant {
  id String @id @default(cuid())
  challengeId String
  userId String
  joinedAt DateTime @default(now())
  challenge GroupChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([challengeId, userId])
  @@index([userId, joinedAt])
}

model GroupMemberRewardBalance {
  id String @id @default(cuid())
  groupId String
  userId String
  balance BigInt @default(0)
  updatedAt DateTime @updatedAt
  group TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model GroupPointLedger {
  id String @id @default(cuid())
  idempotencyKey String @unique
  groupId String
  userId String?
  amount BigInt
  source GroupPointSource
  description String
  createdAt DateTime @default(now())
  group TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([groupId, createdAt])
  @@index([userId, createdAt])
}

model GroupRewardItem {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  cost BigInt
  scope String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  grants GroupRewardGrant[]
}

model GroupRewardGrant {
  id String @id @default(cuid())
  idempotencyKey String @unique
  groupId String
  itemId String
  grantedByUserId String
  recipientUserId String?
  createdAt DateTime @default(now())
  group TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  item GroupRewardItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@index([groupId, createdAt])
  @@index([recipientUserId, createdAt])
}


enum AllianceStatus {
  ACTIVE
  SUSPENDED
  DISSOLVED
}

enum AllianceSeasonReviewStatus {
  PENDING
  FLAGGED
  APPROVED
  REJECTED
}

model Alliance {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String @default("")
  status AllianceStatus @default(ACTIVE)
  treasuryPoints BigInt @default(0)
  createdByGroupId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdByGroup TelegramGroup @relation("AllianceCreatorGroup", fields: [createdByGroupId], references: [id], onDelete: Restrict)
  groups AllianceGroup[]
  invitations AllianceInvitation[]
  seasons AllianceSeason[]
  competitions Competition[]
  ledger AllianceLedger[]
  auditLogs AllianceAuditLog[]
  @@index([status, createdAt])
}

model AllianceGroup {
  id String @id @default(cuid())
  allianceId String
  groupId String @unique
  role String @default("MEMBER")
  joinedAt DateTime @default(now())
  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  group TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([allianceId, groupId])
  @@index([allianceId, joinedAt])
}

model AllianceInvitation {
  id String @id @default(cuid())
  allianceId String
  groupId String
  invitedByGroupId String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  respondedAt DateTime?
  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  group TelegramGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([allianceId, groupId])
  @@index([groupId, status])
}

model AllianceSeason {
  id String @id @default(cuid())
  allianceId String
  number Int
  status String @default("ACTIVE")
  startsAt DateTime @default(now())
  endsAt DateTime
  closedAt DateTime?
  standings Json?
  reviewStatus AllianceSeasonReviewStatus @default(PENDING)
  securityFlags Json?
  reviewedAt DateTime?
  reviewedByUserId String?
  createdAt DateTime @default(now())
  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  @@unique([allianceId, number])
  @@index([allianceId, status, endsAt])
}

model AllianceLedger {
  id String @id @default(cuid())
  allianceId String
  idempotencyKey String @unique
  amount BigInt
  source String
  description String
  createdAt DateTime @default(now())
  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  @@index([allianceId, createdAt])
}

model AllianceAuditLog {
  id String @id @default(cuid())
  allianceId String
  actorTelegramId String
  groupTelegramId String
  action String
  metadata Json?
  createdAt DateTime @default(now())
  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  @@index([allianceId, createdAt])
  @@index([actorTelegramId, createdAt])
}
