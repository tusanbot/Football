{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-empire-bot-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "staging",
    "FOOTBALL_API_URL": "https://football-empire-api-staging.mshmahyar9.workers.dev",
    "TELEGRAM_WEB_APP_URL": "https://football-empire-web-staging.mshmahyar9.workers.dev"
  },
  "analytics_engine_datasets": [{ "binding": "PILOT_ANALYTICS", "dataset": "football_empire_pilot" }],
  "durable_objects": { "bindings": [{ "name": "BOT_UPDATE_GUARD", "class_name": "BotUpdateGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotUpdateGuard"] }],
  // Keep the staging Bot dormant until explicit activation; webhook registration is separate.
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
