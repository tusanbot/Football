{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-empire-web-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "dev": { "port": 8788 },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
