NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_empire
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN= # API and Bot must share this token; Bot must be administrator in alliance groups
BOT_API_SECRET=replace-with-a-long-random-secret-shared-by-api-and-bot
FOOTBALL_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEB_APP_URL=http://localhost:3000

# Comma-separated numeric Telegram user IDs allowed to approve/reject flagged prizes. Reviewers must also be Telegram group admins in the founder group.
ALLIANCE_REVIEWER_TELEGRAM_IDS=

# Comma-separated Telegram numeric IDs allowed to use the central game administration console
GAME_ADMIN_TELEGRAM_IDS=
